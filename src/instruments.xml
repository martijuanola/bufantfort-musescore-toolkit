<museScore>
  <!-- Custom Families of Instruments -->
  <Family id="BF-percu">
        <name>Percu BufantFort</name>
  </Family>
  <Family id="BF-metalls">
        <name>Metalls BufantFort</name>
  </Family>
  <Family id="BF-fusta">
        <name>Fusta BufantFort</name>
  </Family>

  <!-- Custom Instruments Groups -->
  <InstrumentGroup id="BufantFort">
    <name>BufantFort</name>

    <!-- Custom Instruments -->
    <Instrument id="BF-bombo">
      <family>BF-percu</family>

      <trackName>Bombo (BufantFort)</trackName>
      <longName>Bombo</longName>
      <shortName>B.</shortName>
      <!--<musicXMLid>???</musicXMLid>-->
      
      <description>Bombo pel grup BufantFort</description>

      <clef>PERC</clef>
      <stafftype staffTypePreset="perc1Line">percussion</stafftype>
      <barlineSpan>1</barlineSpan>
      <drumset>1</drumset>
      <singleNoteDynamics>0</singleNoteDynamics>

      <Drum pitch="35"> <!-- Bombo -->
            <head>normal</head>
            <line>0</line>
            <voice>0</voice>
            <name>Bombo</name>
            <stem>1</stem>
            <shortcut>B</shortcut>
            <panelRow>0</panelRow>
            <panelColumn>0</panelColumn>
      </Drum>
      <Drum pitch="37"> <!-- Aro Bombo --> <!-- TODO: canviar el so! --> 
            <head>slashed1</head>
            <line>0</line>
            <voice>0</voice>
            <name>Aro</name>
            <stem>1</stem>
            <shortcut>A</shortcut>
            <panelRow>0</panelRow>
            <panelColumn>1</panelColumn>
      </Drum>
      <Drum pitch="31"> <!-- Baquetes -->
            <head>cross</head>
            <line>-2</line>
            <voice>0</voice>
            <name>Stick Click (baquetes)</name>
            <stem>1</stem>
            <shortcut>Q</shortcut>
            <panelRow>0</panelRow>
            <panelColumn>2</panelColumn>
      </Drum>

      <Channel>
            <!--MIDI: Bank 128, Prog 0; MS General: Standard-->
            <controller ctrl="0" value="1"/> <!--Bank MSB-->
            <!--<controller ctrl="32" value="0"/> --> <!-- LSB = 0 -->
            <program value="0"/> <!--Standard Kit-->
      </Channel>

      <genre>marching</genre>

    </Instrument>
    <Instrument id="BF-caixa">
      <family>BF-percu</family>

      <trackName>Caixa (BufantFort)</trackName>
      <longName>Caixa</longName>
      <shortName>C.</shortName>
      <!--<musicXMLid>???</musicXMLid>-->
      
      <description>Caixa pel grup BufantFort</description>

      <clef>PERC</clef>
      <stafftype staffTypePreset="perc5Line">percussion</stafftype>
      <barlineSpan>1</barlineSpan>
      <drumset>1</drumset>
      <singleNoteDynamics>0</singleNoteDynamics>

      <Drum pitch="38"> <!-- Caixa -->
            <head>normal</head>
            <line>3</line>
            <voice>0</voice>
            <name>Caixa</name>
            <stem>1</stem>
            <shortcut>S</shortcut>
            <panelRow>0</panelRow>
            <panelColumn>0</panelColumn>
      </Drum>
      <Drum pitch="37"> <!-- Aro Caixa -->
            <head>slashed1</head>
            <line>3</line>
            <voice>0</voice>
            <name>Aro Caixa</name>
            <stem>1</stem>
            <panelRow>0</panelRow>
            <panelColumn>1</panelColumn>
      </Drum>
      <Drum pitch="31"> <!-- Baquetes -->
            <head>cross</head>
            <line>2</line>
            <voice>0</voice>
            <name>Stick Click (baquetes)</name>
            <stem>1</stem>
            <shortcut>Q</shortcut>
            <panelRow>0</panelRow>
            <panelColumn>2</panelColumn>
      </Drum>
      <!-- ... --> 

      <Drum pitch="42"> <!-- Hi-hat (tancat) -->
            <head>cross</head>
            <line>-1</line>
            <voice>0</voice>
            <name>Hi-Hat (tancat)</name>
            <stem>1</stem>
            <shortcut>H</shortcut>
            <panelRow>1</panelRow>
            <panelColumn>0</panelColumn>
      </Drum>
      <Drum pitch="49"> <!-- Crash 1 -->
            <head>cross</head>
            <line>-2</line>
            <voice>0</voice>
            <name>Crash 1</name>
            <stem>1</stem>
            <shortcut>C</shortcut>
            <panelRow>1</panelRow>
            <panelColumn>1</panelColumn>
      </Drum>
      <Drum pitch="57"> <!-- Crash 2 -->
            <head>cross</head>
            <line>-3</line>
            <voice>0</voice>
            <name>Crash 2</name>
            <stem>1</stem>
            <shortcut>V</shortcut>
            <panelRow>1</panelRow>
            <panelColumn>2</panelColumn>
      </Drum>
      <Drum pitch="28"> <!-- Stack -->
            <head>plus</head>
            <line>-3</line>
            <voice>0</voice>
            <name>Stack</name>
            <stem>1</stem>
            <shortcut>K</shortcut>
            <panelRow>1</panelRow>
            <panelColumn>3</panelColumn>
      </Drum>
      <Drum pitch="55"> <!-- Splash -->
            <head>cross</head>
            <line>-4</line>
            <voice>0</voice>
            <name>Splash</name>
            <stem>1</stem>
            <shortcut>S</shortcut>
            <panelRow>1</panelRow>
            <panelColumn>4</panelColumn>
      </Drum>
      <!-- ... --> 

      <Drum pitch="56"> <!-- Esquetlla -->
            <head>triangle-down</head>
            <line>1</line>
            <voice>0</voice>
            <name>Esquetlla</name>
            <stem>1</stem>
            <shortcut>E</shortcut>
            <panelRow>2</panelRow>
            <panelColumn>0</panelColumn>
      </Drum>
      <!-- ... --> 
      
      



      <Channel>
            <!--MIDI: Bank 128, Prog 0; MS General: Standard-->
            <controller ctrl="0" value="1"/> <!--Bank MSB-->
            <!--<controller ctrl="32" value="0"/> --> <!-- LSB = 0 -->
            <program value="0"/> <!--Standard Kit-->
      </Channel>

      <genre>marching</genre>

    </Instrument>

  </InstrumentGroup>
</museScore>